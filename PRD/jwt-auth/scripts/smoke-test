#!/bin/bash
# JWT Auth Migration Smoke Test
# Usage: ./scripts/smoke-test [checkpoint-1|checkpoint-2|checkpoint-3|all]

set -euo pipefail

BASE_URL="${BASE_URL:-http://localhost:8080}"
CHECKPOINT="${1:-all}"
PASS=0
FAIL=0

green() { echo -e "\033[32m[PASS]\033[0m $1"; ((PASS++)); }
red()   { echo -e "\033[31m[FAIL]\033[0m $1"; ((FAIL++)); }
info()  { echo -e "\033[34m[INFO]\033[0m $1"; }

# ---- Checkpoint 1: JWT Util + Login Endpoint ----
test_checkpoint_1() {
    info "=== Checkpoint 1: JWT Util + Login Endpoint ==="

    # 1.1 Login returns tokens
    LOGIN_RESP=$(curl -s -w "\n%{http_code}" -X POST "$BASE_URL/auth/login" \
        -H "Content-Type: application/json" \
        -d '{"username":"admin","password":"admin123"}')

    HTTP_CODE=$(echo "$LOGIN_RESP" | tail -1)
    BODY=$(echo "$LOGIN_RESP" | sed '$d')

    if [[ "$HTTP_CODE" == "200" ]]; then
        green "1.1 Login endpoint returns 200"
    else
        red "1.1 Login endpoint returned $HTTP_CODE, expected 200"
    fi

    # Check for accessToken and refreshToken in response
    if echo "$BODY" | grep -q "accessToken"; then
        green "1.2 Response contains accessToken"
    else
        red "1.2 Response missing accessToken"
    fi

    if echo "$BODY" | grep -q "refreshToken"; then
        green "1.3 Response contains refreshToken"
    else
        red "1.3 Response missing refreshToken"
    fi

    # 1.4 No JSESSIONID cookie set
    HEADERS=$(curl -s -D - -o /dev/null -X POST "$BASE_URL/auth/login" \
        -H "Content-Type: application/json" \
        -d '{"username":"admin","password":"admin123"}')

    if echo "$HEADERS" | grep -qi "Set-Cookie.*JSESSIONID"; then
        red "1.4 JSESSIONID cookie still set after login"
    else
        green "1.4 No JSESSIONID cookie set after login"
    fi
}

# ---- Checkpoint 2: JWT Filter + SecurityConfig ----
test_checkpoint_2() {
    info "=== Checkpoint 2: JWT Filter + SecurityConfig ==="

    # Get tokens first
    LOGIN_RESP=$(curl -s -X POST "$BASE_URL/auth/login" \
        -H "Content-Type: application/json" \
        -d '{"username":"admin","password":"admin123"}')

    ACCESS_TOKEN=$(echo "$LOGIN_RESP" | grep -o '"accessToken":"[^"]*"' | cut -d'"' -f4)
    REFRESH_TOKEN=$(echo "$LOGIN_RESP" | grep -o '"refreshToken":"[^"]*"' | cut -d'"' -f4)

    if [[ -z "$ACCESS_TOKEN" ]]; then
        red "2.0 Cannot get access token, skipping remaining tests"
        return
    fi

    # 2.1 Authenticated request with Bearer token
    ME_RESP=$(curl -s -w "\n%{http_code}" "$BASE_URL/auth/me" \
        -H "Authorization: Bearer $ACCESS_TOKEN")

    ME_CODE=$(echo "$ME_RESP" | tail -1)
    ME_BODY=$(echo "$ME_RESP" | sed '$d')

    if [[ "$ME_CODE" == "200" ]] && echo "$ME_BODY" | grep -q '"authenticated":true'; then
        green "2.1 GET /auth/me returns authenticated user with Bearer token"
    else
        red "2.1 GET /auth/me failed (HTTP $ME_CODE)"
    fi

    # 2.2 Protected endpoint without token returns 401
    NO_AUTH_RESP=$(curl -s -w "\n%{http_code}" "$BASE_URL/documents")
    NO_AUTH_CODE=$(echo "$NO_AUTH_RESP" | tail -1)

    if [[ "$NO_AUTH_CODE" == "401" ]] || [[ "$NO_AUTH_CODE" == "403" ]]; then
        green "2.2 Protected endpoint without token returns $NO_AUTH_CODE"
    else
        red "2.2 Protected endpoint without token returned $NO_AUTH_CODE, expected 401/403"
    fi

    # 2.3 Protected endpoint with token returns 200
    DOCS_RESP=$(curl -s -w "\n%{http_code}" "$BASE_URL/documents" \
        -H "Authorization: Bearer $ACCESS_TOKEN")
    DOCS_CODE=$(echo "$DOCS_RESP" | tail -1)

    if [[ "$DOCS_CODE" == "200" ]]; then
        green "2.3 Protected endpoint with token returns 200"
    else
        red "2.3 Protected endpoint with token returned $DOCS_CODE"
    fi

    # 2.4 Refresh token endpoint works
    if [[ -n "$REFRESH_TOKEN" ]]; then
        REFRESH_RESP=$(curl -s -w "\n%{http_code}" -X POST "$BASE_URL/auth/refresh" \
            -H "Content-Type: application/json" \
            -d "{\"refreshToken\":\"$REFRESH_TOKEN\"}")

        REFRESH_CODE=$(echo "$REFRESH_RESP" | tail -1)
        REFRESH_BODY=$(echo "$REFRESH_RESP" | sed '$d')

        if [[ "$REFRESH_CODE" == "200" ]] && echo "$REFRESH_BODY" | grep -q "accessToken"; then
            green "2.4 Refresh token endpoint returns new tokens"
        else
            red "2.4 Refresh token endpoint failed (HTTP $REFRESH_CODE)"
        fi
    else
        red "2.4 No refresh token available for testing"
    fi

    # 2.5 Invalid token returns 401
    INVALID_RESP=$(curl -s -w "\n%{http_code}" "$BASE_URL/auth/me" \
        -H "Authorization: Bearer invalid.token.here")
    INVALID_CODE=$(echo "$INVALID_RESP" | tail -1)

    if [[ "$INVALID_CODE" == "401" ]]; then
        green "2.5 Invalid token returns 401"
    else
        red "2.5 Invalid token returned $INVALID_CODE, expected 401"
    fi
}

# ---- Checkpoint 3: Frontend (manual verification notes) ----
test_checkpoint_3() {
    info "=== Checkpoint 3: Frontend Adaptation ==="
    info "Frontend changes require manual browser testing."
    info "Verify the following in both React and Vue frontends:"
    echo ""
    echo "  1. Login stores token in localStorage (not cookie)"
    echo "  2. API requests include Authorization: Bearer header"
    echo "  3. Access Token expiry triggers automatic refresh"
    echo "  4. Refresh Token expiry redirects to login page"
    echo "  5. Page refresh maintains logged-in state"
    echo "  6. Logout clears localStorage tokens"
    echo "  7. Admin pages enforce role-based visibility"
    echo ""

    # Automated check: frontend files no longer use credentials: include
    REACT_API="frontend/src/lib/api.ts"
    VUE_API="front-vue/src/lib/api.ts"

    if [[ -f "$REACT_API" ]]; then
        if grep -q 'credentials.*include' "$REACT_API" 2>/dev/null; then
            red "3.1 React api.ts still uses credentials: include"
        else
            green "3.1 React api.ts no longer uses credentials: include"
        fi
    fi

    if [[ -f "$VUE_API" ]]; then
        if grep -q 'credentials.*include' "$VUE_API" 2>/dev/null; then
            red "3.2 Vue api.ts still uses credentials: include"
        else
            green "3.2 Vue api.ts no longer uses credentials: include"
        fi
    fi
}

# ---- Main ----
main() {
    echo "JWT Auth Migration Smoke Test"
    echo "Target: $BASE_URL"
    echo ""

    case "$CHECKPOINT" in
        checkpoint-1) test_checkpoint_1 ;;
        checkpoint-2) test_checkpoint_2 ;;
        checkpoint-3) test_checkpoint_3 ;;
        all)
            test_checkpoint_1
            echo ""
            test_checkpoint_2
            echo ""
            test_checkpoint_3
            ;;
        *)
            echo "Usage: $0 [checkpoint-1|checkpoint-2|checkpoint-3|all]"
            exit 1
            ;;
    esac

    echo ""
    echo "=============================="
    echo "Results: $PASS passed, $FAIL failed"
    echo "=============================="

    if [[ $FAIL -gt 0 ]]; then
        exit 1
    fi
}

main
